{
  "name": "@gymlog/schemas",
  "private": true,
  "version": "0.0.0",
  "description": "Zod schemas and API contracts shared by @gymlog/web and @gymlog/api",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "lint": "oxlint",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "date-fns": "^4.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "oxlint": "^1.88.0",
    "typescript": "~6.0.3"
  }
}
