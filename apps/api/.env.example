# Copy to .env for local development: cp .env.example .env

# Local Postgres from compose.yaml in the repo root (docker compose up -d).
# In prod — the Neon connection string.
DATABASE_URL="postgresql://gymlog:gymlog@localhost:5434/gymlog"

# Only for migrations in prod: Neon's direct (non-pooled) connection string.
# Locally not needed — migrations fall back to DATABASE_URL.
# DIRECT_URL=""

# Secret for signing access tokens, at least 32 characters.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

PORT=3000

# Locally the API runs on plain http, where browsers drop Secure cookies.
COOKIE_SECURE=false
